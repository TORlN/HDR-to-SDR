# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
*.exe
*.mp4

# Virtual environment
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.env
.env/
*.iso

# PyInstaller
build/
dist/
*.spec
# ...except the build spec itself: it defines the shipped binary (bundled
# ffmpeg/ffprobe, the LUT, and the four pro.* hiddenimports that a Pro release
# depends on). The blanket *.spec rule above kept it untracked for the whole
# project history -- a disk failure would have taken the release pipeline with
# it. Must stay after *.spec so the negation isn't re-shadowed.
!HDR_to_SDR_Converter.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt
*.log
debug.log

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.cache
.pytest_cache/

# VS Code settings
.vscode/
claude/
.claude

# Script files
*.sh
*.bat
# ...except the release build script: it carries the pre-build test gate, the
# free-build confirmation alarm, the PyArmor branch, Azure code signing, and the
# PYZ bundle check that stops a Pro-labeled installer shipping without Pro code.
# Signing credentials are NOT in here -- they live in signing/metadata.json,
# which stays ignored via the signing/ rule below.
!build_installer.bat
*.gitignore
*.ps1
video.mkv
error.png
.gitignore
Shōgun S01e01 Anjin.mkv
.gitignore
mock_license.py
make_comparison.py
comparison.png
*.mkv
old_icon.ico
old_icon.png

# Secrets — never commit
src/_secrets.py
signing/

# Private Pro repo — nested independent git repo, never tracked here.
# See docs/superpowers/specs/2026-07-30-pro-private-repo-split-design.md
src/pro/

# Committed smoke-test video fixtures (small, deliberately un-ignored so CI can
# exercise the real ffmpeg pipeline against them; must come after every *.mp4/
# *.mkv rule above so the negation isn't re-shadowed).
!test/smoke_test_videos/*.mp4
!test/smoke_test_videos/*.mkv
docs/
.superpowers/
HDR to SDR.code-workspace
